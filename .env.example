# Copia este archivo como .env y completa los valores.
# Nunca subas el .env real al repositorio.

# --- Aplicación ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DEMO_MODE=True

# En producción con HTTPS:
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=dominio-del-eleam.cl
# CSRF_TRUSTED_ORIGINS=https://dominio-del-eleam.cl
# SECURE_SSL_REDIRECT=True
# USE_X_FORWARDED_PROTO=True

# --- Base de datos ---
# Sin estas variables se usa SQLite solo para desarrollo local.
# En producción se recomienda PostgreSQL administrado.
# POSTGRES_DB=eleam
# POSTGRES_USER=eleam
# POSTGRES_PASSWORD=cambia-esto
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
